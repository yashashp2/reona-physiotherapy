# Never prefix secrets below with NEXT_PUBLIC_. Copy to .env.local.
# Local browser origin must match exactly. Set your HTTPS custom domain on Vercel.
SITE_URL=http://127.0.0.1:3000
# Forms also require practice.launchReady=true after all content/legal checks.
ENQUIRIES_ENABLED=false
RESEND_API_KEY=
# Use a verified sending domain, e.g. Practice <enquiries@your-domain.example>
ENQUIRY_FROM=
# Private practice inbox; not bundled into browser code.
ENQUIRY_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a long random secret; see README.
RATE_LIMIT_SECRET=
